.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 140rpx;
}
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 0;
  color: #999;
}
.content { padding: 20rpx; }

.total-card {
  background: linear-gradient(135deg, #07c160, #06ad56);
  border-radius: 20rpx;
  padding: 40rpx;
  text-align: center;
  color: #fff;
  margin-bottom: 24rpx;
}
.total-num {
  font-size: 56rpx;
  font-weight: 700;
  display: block;
}
.total-label {
  font-size: 26rpx;
  opacity: 0.85;
  margin-top: 8rpx;
  display: block;
}

.stat-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.sec-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.stat-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 14rpx;
}
.stat-label {
  width: 72rpx;
  font-size: 24rpx;
  color: #666;
  flex-shrink: 0;
}
.stat-bar-bg {
  flex: 1;
  height: 18rpx;
  background: #f0f0f0;
  border-radius: 9rpx;
  overflow: hidden;
}
.stat-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #07c160, #2ecc71);
  border-radius: 9rpx;
  transition: width 0.3s;
}
.stat-val {
  width: 100rpx;
  font-size: 22rpx;
  color: #999;
  text-align: right;
  flex-shrink: 0;
}

.count-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.count-item {
  flex: 1;
  min-width: 100rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
  padding: 20rpx 12rpx;
  text-align: center;
}
.count-num {
  font-size: 36rpx;
  font-weight: 700;
  color: #07c160;
  display: block;
}
.count-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
  display: block;
}

.month-divider {
  height: 2rpx;
  background: #e0e0e0;
  margin: 32rpx 0 8rpx;
}
.month-title {
  font-size: 30rpx;
  color: #333;
  margin-bottom: 8rpx;
  padding: 16rpx;
  background: #fff;
  border-radius: 12rpx;
  text-align: center;
}
.month-title:active { background: #f0f0f0; }
.month-empty {
  text-align: center;
  font-size: 26rpx;
  color: #bbb;
  padding: 40rpx 0;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}
.total-card.mini {
  padding: 24rpx;
  margin-bottom: 20rpx;
}
.total-card.mini .total-num {
  font-size: 40rpx;
}

.debug-row {
  text-align: center; padding: 20rpx; border-top: 2rpx solid #eee; margin: 20rpx;
}
.debug-text {
  font-size: 22rpx; color: #bbb; word-break: break-all;
}
