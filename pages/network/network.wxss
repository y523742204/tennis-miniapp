.page { min-height: 100vh; background: #f5f5f5; padding: 20rpx 20rpx 40rpx; }
.summary-card { background: #fff; border-radius: 16rpx; padding: 30rpx 20rpx; margin-bottom: 20rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04); }
.summary-row { display: flex; justify-content: space-around; }
.summary-item { text-align: center; }
.summary-num { font-size: 40rpx; font-weight: 700; color: #2ecc71; display: block; }
.summary-label { font-size: 24rpx; color: #999; margin-top: 6rpx; display: block; }
.section-title { font-size: 28rpx; font-weight: 600; color: #333; margin-bottom: 16rpx; }
.player-card { background: #fff; border-radius: 12rpx; margin-bottom: 12rpx; padding: 24rpx 20rpx; box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.03); }
.player-row { display: flex; align-items: center; justify-content: space-between; }
.player-name { font-size: 30rpx; font-weight: 600; color: #222; }
.player-counts { display: flex; gap: 12rpx; }
.tag { font-size: 22rpx; padding: 4rpx 14rpx; border-radius: 20rpx; }
.tag.partner { background: #e8f8ee; color: #07c160; }
.tag.opponent { background: #fdecea; color: #e74c3c; }
.player-detail { margin-top: 16rpx; padding-top: 16rpx; border-top: 2rpx solid #f0f0f0; overflow-x: auto; }
.rel-label { font-size: 26rpx; font-weight: 600; margin: 8rpx 0 6rpx; }

.rel-label.partner { color: #07c160; }
.rel-label.opponent { color: #e74c3c; }
.rel-grid { display: flex; flex-wrap: wrap; gap: 0; margin-bottom: 4rpx; }
.rel-cell { width: 80rpx; flex-shrink: 0; text-align: center; }
.rel-name, .rel-count { display: block; font-size: 22rpx; line-height: 1.6; }
.rel-name.active, .rel-count.active { color: #222; font-weight: 600; }
.rel-name.inactive, .rel-count.inactive { color: #ccc; font-weight: 400; }
