<view class="container">
  <view class="top-bar">
    <view class="week-nav">
      <view class="nav-btn" bindtap="prevWeek">‹</view>
      <picker mode="date" value="{{currentDate}}" bindchange="onDatePick">
        <text class="week-label">{{weekLabel}}</text>
      </picker>
      <view class="nav-btn" bindtap="nextWeek">›</view>
      <view class="today-btn" bindtap="goThisWeek">本周</view>
    </view>
  </view>

  <scroll-view class="grid-scroll" scroll-x scroll-y enhanced show-scrollbar="{{false}}">
    <view class="grid">

      <view class="grid-row header-row">
        <view class="corner"></view>
        <view wx:for="{{days}}" wx:key="date" class="head-cell {{item.isToday ? 'today' : ''}}">
          <text class="hd-week">{{item.label}}</text>
          <text class="hd-date">{{item.dateText}}</text>
        </view>
      </view>

      <view wx:for="{{slots}}" wx:for-index="si" wx:key="text" class="grid-row">
        <view class="time-cell {{item.isHour ? '' : 'half'}} {{item.isEnd ? 'end' : ''}}">
          <text>{{item.text}}</text>
        </view>
        <block wx:if="{{!item.isEnd}}">
          <view wx:for="{{days}}" wx:for-index="di" wx:key="date"
                class="cell {{selectedSet[di + '-' + si] ? 'selected' : ''}} {{hasTrainingMap[di + '-' + si] ? 'occupied' : ''}}"
                data-day="{{di}}" data-slot="{{si}}" catchtap="onCellTap">
          </view>
        </block>
        <block wx:else>
          <view wx:for="{{days}}" wx:for-index="di" wx:key="date"
                class="cell end-cell">
          </view>
        </block>
      </view>

      <view wx:for="{{cards}}" wx:key="id" class="card"
            style="left:{{item.left}}rpx;top:{{item.top}}rpx;width:{{item.width}}rpx;height:{{item.height}}rpx;background:{{item.color}};font-size:{{item.fontSize}}rpx;"
            data-id="{{item.id}}" catchtap="onCardTap">
        <text class="card-type">{{item.typeLabel}}</text>
        <text wx:if="{{item.level > 0}}" class="card-info">{{item.level}}</text>
        <text wx:if="{{item.court}}" class="card-info">{{item.court}}</text>
        <text wx:if="{{item.notes}}" class="card-info">{{item.notes}}</text>
      </view>

    </view>
  </scroll-view>

  <view wx:if="{{selectedCells.length && !showForm && !showDetail}}" class="sel-bar">
    <text class="sel-text">已选 {{selectedCells.length}} 个时段</text>
    <view class="sel-btn sel-clear" catchtap="_clearSelection">清除</view>
    <view class="sel-btn sel-add" catchtap="showAddForm">+ 新增训练</view>
  </view>

  <view wx:if="{{showDetail}}" class="overlay" data-close="1" bindtap="closeDetail">
    <view class="sheet">
      <view class="sheet-title" style="border-left:8rpx solid {{detailRecord.color}};">
        <text class="sheet-name">{{detailRecord.typeLabel}}</text>
        <text class="sheet-date">{{detailRecord.date}} {{detailRecord.startTime}}-{{detailRecord.endTime}}</text>
      </view>
      <view class="sheet-body">
        <view class="sheet-row"><text class="sl">时长</text><text class="sv">{{detailRecord.durationText}}</text></view>
        <view class="sheet-row"><text class="sl">类型</text><text class="sv">{{detailRecord.typeLabel}}</text></view>
        <view class="sheet-row"><text class="sl">等级</text><text class="sv">{{detailRecord.levelText}}</text></view>
        <view wx:if="{{detailRecord.court}}" class="sheet-row"><text class="sl">场地</text><text class="sv">{{detailRecord.court}}</text></view>
        <view wx:if="{{detailRecord.notes}}" class="sheet-row"><text class="sl">备注</text><text class="sv">{{detailRecord.notes}}</text></view>
      </view>
      <view class="sheet-actions">
        <view class="sa sa-edit" bindtap="editFromDetail">编辑</view>
        <view class="sa sa-del" bindtap="deleteFromDetail">删除</view>
      </view>
    </view>
  </view>

  <view wx:if="{{showForm}}" class="overlay" data-close="1" bindtap="closeForm">
    <view class="sheet">
      <view class="sheet-title" style="border-left:8rpx solid #07c160;">
        <text class="sheet-name">{{formMode === 'add' ? '新增训练' : '编辑训练'}}</text>
        <text class="sheet-date">{{formData.date}} {{formData.startTime}}-{{formData.endTime}}</text>
      </view>
      <view class="sheet-body">
        <view class="sheet-row">
          <text class="sl">日期</text>
          <text class="sv">{{formData.date}}</text>
        </view>
        <view wx:if="{{formMode === 'add'}}" class="sheet-row">
          <text class="sl">开始</text>
          <text class="sv">{{formData.startTime}}</text>
        </view>
        <view wx:if="{{formMode === 'add'}}" class="sheet-row">
          <text class="sl">结束</text>
          <text class="sv">{{formData.endTime}}</text>
        </view>
        <view wx:if="{{formMode === 'edit'}}" class="sheet-row">
          <text class="sl">开始</text>
          <picker mode="selector" range="{{pickerItems}}" value="{{startTimeIndex}}" bindchange="pickStartTime">
            <text class="sv">{{formData.startTime}}</text>
          </picker>
        </view>
        <view wx:if="{{formMode === 'edit'}}" class="sheet-row">
          <text class="sl">结束</text>
          <picker mode="selector" range="{{pickerItems}}" value="{{endTimeIndex}}" bindchange="pickEndTime">
            <text class="sv">{{formData.endTime}}</text>
          </picker>
        </view>
        <view class="sheet-row">
          <text class="sl">训练类型</text>
          <picker mode="selector" range="{{trainingTypes}}" range-key="label" value="{{formTypeIndex}}" bindchange="formSelectType">
            <text class="sv">{{formTypeLabel}}</text>
          </picker>
        </view>
        <view class="sheet-row">
          <text class="sl">训练等级</text>
          <picker mode="selector" range="{{levelOptions}}" value="{{levelIndex}}" bindchange="formSelectLevel">
            <text class="sv">{{formData.level}}</text>
          </picker>
        </view>
        <view class="sheet-row">
          <text class="sl">场地</text>
          <input class="sv" placeholder="可选" value="{{formData.court}}" data-field="court" bindinput="formInput"/>
        </view>
        <view class="sheet-row">
          <text class="sl">备注</text>
          <input class="sv" placeholder="可选" value="{{formData.notes}}" data-field="notes" bindinput="formInput"/>
        </view>
      </view>
      <view class="sheet-actions">
        <view class="sa sa-cancel" catchtap="cancelForm">取消</view>
        <view class="sa sa-save" catchtap="submitForm">保存</view>
      </view>
    </view>
  </view>
</view>
