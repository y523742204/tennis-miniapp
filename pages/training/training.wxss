.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f5f5;
  overflow: hidden;
}

.top-bar {
  padding: 20rpx 30rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
  flex-shrink: 0;
}

.week-nav {
  display: flex;
  align-items: center;
}

.nav-btn {
  width: 60rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  font-size: 36rpx;
  color: #666;
  border-radius: 8rpx;
  background: #f0f0f0;
}

.nav-btn:active {
  background: #ddd;
}

.week-label-pick {
  flex: 1;
  display: flex;
  justify-content: center;
}
.week-label-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.today-btn {
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  color: #07c160;
  border: 1rpx solid #07c160;
  border-radius: 8rpx;
  margin-left: 16rpx;
}

.grid-scroll {
  flex: 1;
  height: 0;
}

.grid {
  position: relative;
  width: 1325rpx;
  background: #fff;
}

.grid-row {
  display: flex;
}

.header-row {
  position: sticky;
  top: 0;
  z-index: 10;
  background: #fff;
}

.corner {
  width: 100rpx;
  height: 80rpx;
  flex-shrink: 0;
  position: sticky;
  left: 0;
  z-index: 12;
  background: #fff;
  border-right: 1rpx solid #e0e0e0;
  border-bottom: 1rpx solid #e0e0e0;
}

.head-cell {
  width: 175rpx;
  height: 80rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-bottom: 1rpx solid #e0e0e0;
  border-right: 1rpx solid #f0f0f0;
  background: #fff;
}

.hd-week {
  font-size: 22rpx;
  color: #999;
}

.hd-date {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
  margin-top: 2rpx;
}

.head-cell.today .hd-date {
  color: #07c160;
  font-weight: 700;
}

.time-cell {
  width: 100rpx;
  height: 60rpx;
  flex-shrink: 0;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  background: #fafafa;
  position: sticky;
  left: 0;
  z-index: 5;
  border-right: 1rpx solid #e0e0e0;
  box-sizing: border-box;
}

.time-cell text {
  margin-top: -0.55em;
  font-size: 26rpx;
  color: #999;
}

.time-cell.end text {
  font-weight: 600;
  color: #666;
}

.cell {
  width: 175rpx;
  height: 60rpx;
  flex-shrink: 0;
  border-right: 1rpx solid #f0f0f0;
  border-top: 1rpx solid #f0f0f0;
  box-sizing: border-box;
}

.cell:active {
  background: #e8f5e9;
}

.cell.selected {
  background: #c8e6c9;
}

.cell.occupied {
  background: #e0e0e0;
}

.end-cell {
  width: 175rpx;
  height: 60rpx;
  flex-shrink: 0;
  border-right: 1rpx solid #f0f0f0;
  border-top: 1rpx solid #f0f0f0;
  box-sizing: border-box;
  background: #fafafa;
}

.card {
  position: absolute;
  border-radius: 8rpx;
  padding: 2rpx 2rpx;
  box-sizing: border-box;
  overflow: hidden;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.card:active {
  opacity: 0.8;
}

.card-type {
  font-weight: 600;
  color: #fff;
  text-align: center;
  width: 100%;
}

.card-info {
  font-weight: 600;
  color: rgba(255,255,255,0.9);
  text-align: center;
  width: 100%;
}

.sel-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  padding: 16rpx 30rpx;
  background: #fff;
  border-top: 1rpx solid #e0e0e0;
  z-index: 100;
}

.sel-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  text-align: center;
}

.sel-btn {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  font-size: 28rpx;
  border-radius: 10rpx;
}

.sel-clear {
  color: #666;
  border: 1rpx solid #ccc;
  margin-right: 20rpx;
}

.sel-add {
  color: #fff;
  background: #07c160;
}

.overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.4);
  z-index: 200;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.sheet {
  width: 100%;
  background: #fff;
  border-radius: 20rpx 20rpx 0 0;
  max-height: 80vh;
  overflow-y: auto;
}

.sheet-title {
  display: flex;
  flex-direction: column;
  padding: 30rpx;
  gap: 8rpx;
}

.sheet-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #333;
}

.sheet-date {
  font-size: 26rpx;
  color: #999;
}

.sheet-body {
  padding: 0 30rpx;
}

.sheet-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.sheet-actions {
  display: flex;
  padding: 30rpx;
  gap: 20rpx;
}

.sa {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  font-size: 28rpx;
  border-radius: 10rpx;
}

.sa-edit {
  color: #fff;
  background: #07c160;
}

.sa-del {
  color: #e53935;
  border: 1rpx solid #e53935;
}

.sa-cancel {
  color: #666;
  border: 1rpx solid #ccc;
}

.sa-save {
  color: #fff;
  background: #07c160;
}

.sl {
  width: 160rpx;
  font-size: 26rpx;
  color: #999;
  flex-shrink: 0;
}

.sv {
  flex: 1;
  font-size: 26rpx;
  color: #333;
}

.sheet-row input.sv {
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
}

.sheet-row picker {
  flex: 1;
}
