.container { height: 100vh; display: flex; flex-direction: column; background: #f5f5f5; }

.top-bar { display: flex; padding: 16rpx 20rpx; background: #fff; }
.publish-btn {
  flex: 1; height: 72rpx; display: flex; align-items: center; justify-content: center;
  background: #9b59b6; color: #fff; font-size: 28rpx; font-weight: 600;
  border-radius: 36rpx;
}
.publish-btn:active { opacity: 0.8; }

.empty-state { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #999; font-size: 28rpx; }

.list-scroll { flex: 1; overflow-y: auto; padding: 16rpx 20rpx; box-sizing: border-box; }

.activity-card {
  background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04); position: relative;
}
.ac-del {
  width: 36rpx; height: 36rpx; display: flex; align-items: center; justify-content: center;
  font-size: 24rpx; color: #ff4757; border-radius: 50%; flex-shrink: 0; margin-left: 8rpx;
}
.ac-del:active { background: #fce4ec; }
.ac-top-row { display: flex; align-items: center; margin-bottom: 6rpx; }
.ac-time { font-size: 30rpx; font-weight: 600; color: #222; flex: 1; }
.ac-del {
  width: 36rpx; height: 36rpx; display: flex; align-items: center; justify-content: center;
  font-size: 24rpx; color: #ff4757; border-radius: 50%; flex-shrink: 0;
}
.ac-del:active { background: #fce4ec; }
.ac-location { font-size: 32rpx; font-weight: 500; color: #333; margin-bottom: 6rpx; }
.ac-type-line { font-size: 36rpx; font-weight: 700; text-align: center; color: #333; margin-bottom: 6rpx; }
.ac-level-limit { font-size: 28rpx; color: #666; text-align: center; margin-bottom: 6rpx; }
.ac-fee { font-size: 28rpx; color: #e67e22; font-weight: 500; text-align: right; margin-bottom: 6rpx; }
.ac-count-row { display: flex; gap: 48rpx; justify-content: center; margin-bottom: 8rpx; font-size: 32rpx; font-weight: 600; }
.ac-count-m { color: #2e7d32; }
.ac-count-f { color: #c62828; }
.ac-count-total { color: #333; }
.wait-badge { font-size: 24rpx; color: #e67e22; font-weight: 400; }

.ac-detail { margin: 12rpx 0; padding-top: 12rpx; border-top: 2rpx solid #f0f0f0; }
.ac-detail-title { font-size: 26rpx; font-weight: 600; color: #444; margin-bottom: 10rpx; }
.ac-detail-table { display: flex; gap: 24rpx; }
.ac-detail-col { flex: 1; display: flex; flex-direction: column; gap: 8rpx; }
.ac-detail-name { font-size: 32rpx; padding: 8rpx 16rpx; border-radius: 10rpx; text-align: center; }
.ac-detail-col:first-child .ac-detail-name { background: #e3f2fd; color: #1565c0; }
.ac-detail-col:last-child .ac-detail-name { background: #fce4ec; color: #c62828; }
.ac-detail-name.wait { opacity: 0.5; }
.ac-detail-wait { margin-top: 16rpx; border-top: 2rpx dashed #eee; padding-top: 12rpx; }

.ac-actions { display: flex; gap: 12rpx; margin-top: 12rpx; }
.ac-btn {
  flex: 1; height: 60rpx; display: flex; align-items: center; justify-content: center;
  border-radius: 30rpx; font-size: 26rpx; font-weight: 500;
}
.ac-btn.primary { background: #9b59b6; color: #fff; }
.ac-btn.primary:active { opacity: 0.8; }
.ac-btn.cancel { background: #f5f5f5; color: #666; }
.ac-btn.cancel:active { opacity: 0.8; }
.ac-btn.edit { background: #fff; color: #9b59b6; border: 2rpx solid #9b59b6; }
.ac-btn.edit:active { background: #f3e5f5; }
.ac-btn.danger { background: #ff4757; color: #fff; }
.ac-btn.danger:active { opacity: 0.8; }
.ac-btn.disabled { background: #f0f0f0; color: #ccc; }

.overlay {
  position: fixed; inset: 0; background: rgba(0,0,0,0.45); z-index: 100;
  display: flex; align-items: flex-end; justify-content: center;
}
.form-sheet, .join-sheet, .pwd-sheet {
  background: #fff; border-radius: 24rpx 24rpx 0 0; width: 100%;
  max-height: 80vh; overflow-y: auto; animation: slideUp .25s ease;
}
@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}
.form-title, .sheet-title {
  font-size: 34rpx; font-weight: 600; padding: 28rpx 32rpx 16rpx; color: #222; text-align: center;
}
.form-body { padding: 0 32rpx; }
.form-group { margin-bottom: 24rpx; }
.form-label { font-size: 26rpx; color: #666; margin-bottom: 8rpx; display: block; }
.form-input {
  width: 100%; height: 72rpx; border: 2rpx solid #e5e7eb; border-radius: 12rpx;
  padding: 0 20rpx; font-size: 28rpx; background: #fafafa; box-sizing: border-box;
}
.form-input.picker {
  display: flex; align-items: center; color: #333;
}
.form-row { display: flex; gap: 20rpx; }
.form-group.half { flex: 1; }

.gender-row { display: flex; gap: 16rpx; }
.gender-option {
  flex: 1; height: 72rpx; display: flex; align-items: center; justify-content: center;
  border-radius: 36rpx; font-size: 28rpx; background: #f5f5f5; color: #666;
}
.gender-option.on { background: #9b59b6; color: #fff; font-weight: 600; }
.gender-option:active { opacity: 0.8; }

.form-actions, .sheet-actions {
  display: flex; padding: 20rpx 32rpx; gap: 20rpx; border-top: 2rpx solid #eee; margin-top: 8rpx;
}
.f-btn {
  flex: 1; height: 80rpx; display: flex; align-items: center; justify-content: center;
  border-radius: 40rpx; font-size: 30rpx; font-weight: 500;
}
.f-cancel { background: #f5f5f5; color: #666; }
.f-submit { background: linear-gradient(135deg, #9b59b6, #8e44ad); color: #fff; }
.f-cancel:active, .f-submit:active { opacity: 0.8; }

.cancel-sheet {
  background: #fff; border-radius: 24rpx 24rpx 0 0; width: 100%;
  max-height: 60vh; overflow-y: auto; animation: slideUp .25s ease;
  padding: 0 32rpx 40rpx;
}
.cancel-name-item {
  height: 80rpx; display: flex; align-items: center; justify-content: center;
  font-size: 30rpx; color: #333; border-bottom: 2rpx solid #f0f0f0;
}
.cancel-name-item:active { background: #f5f5f5; }