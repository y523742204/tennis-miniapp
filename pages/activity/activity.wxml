<view class="container">
  <view class="top-bar">
    <view class="publish-btn" bindtap="openForm">＋ 记录活动</view>
  </view>

  <view wx:if="{{activities.length === 0}}" class="empty-state">
    <text>暂无活动</text>
    <text style="font-size: 26rpx; color: #bbb; margin-top: 12rpx;">点击上方按钮记录活动</text>
  </view>

  <scroll-view scroll-y class="list-scroll" wx:else>
    <view wx:for="{{activities}}" wx:for-index="idx" wx:key="id" class="activity-card" bindtap="toggleExpand" data-idx="{{idx}}">
      <view class="ac-top-row">
        <view class="ac-time">{{item.date}} {{item.weekday}} {{item.time}}-{{item.endTime || item.time}}</view>
        <view class="ac-del" catchtap="deleteActivity" data-idx="{{idx}}">✕</view>
      </view>
      <view class="ac-location">{{item.location}}</view>
      <view class="ac-type-line" wx:if="{{item.typeLabel}}">{{item.typeLabel}}</view>
      <view class="ac-level-limit">（水平限制：{{item.levelStr}}）</view>
      <view class="ac-fee" wx:if="{{item.fee}}">{{item.fee}}元/人</view>
      <view class="ac-count-row">
        <view class="ac-count-m">男 [ {{item.maleCount}} / {{item.maxMale}} ]<text wx:if="{{item.maleWaitCount}}" class="wait-badge"> 候补{{item.maleWaitCount}}</text></view>
        <view class="ac-count-f">女 [ {{item.femaleCount}} / {{item.maxFemale}} ]<text wx:if="{{item.femaleWaitCount}}" class="wait-badge"> 候补{{item.femaleWaitCount}}</text></view>
        <view class="ac-count-total">总 [ {{item.totalCount}} / {{item.totalPlayers}} ]</view>
      </view>
      <view wx:if="{{expandedIdx === idx}}" class="ac-detail">
        <view class="ac-detail-title">已报名：</view>
        <view class="ac-detail-table">
          <view class="ac-detail-col">
            <view wx:for="{{item.maleDisplay}}" wx:key="*this" class="ac-detail-name">{{item}}</view>
          </view>
          <view class="ac-detail-col">
            <view wx:for="{{item.femaleDisplay}}" wx:key="*this" class="ac-detail-name">{{item}}</view>
          </view>
        </view>
        <view wx:if="{{item.maleWaitDisplay.length || item.femaleWaitDisplay.length}}" class="ac-detail-wait">
          <view class="ac-detail-title">候补：</view>
          <view class="ac-detail-table">
            <view class="ac-detail-col">
              <view wx:for="{{item.maleWaitDisplay}}" wx:key="*this" class="ac-detail-name wait">{{item}}</view>
            </view>
            <view class="ac-detail-col">
              <view wx:for="{{item.femaleWaitDisplay}}" wx:key="*this" class="ac-detail-name wait">{{item}}</view>
        </view>
        <view class="form-group">
          <text class="form-label">费用（元/人）</text>
          <input class="form-input" type="number" value="{{formData.fee}}" data-field="fee" bindinput="formInput"/>
        </view>
      </view>
        </view>
      </view>
      <view class="ac-actions" catchtap="noop">
        <view class="ac-btn primary" bindtap="showJoinDialog" data-idx="{{idx}}">添加活动人员</view>
        <view wx:if="{{item._joined}}" class="ac-btn cancel" bindtap="cancelJoin" data-idx="{{idx}}">取消活动人员</view>
        <view wx:if="{{item.creatorId === myOpenid}}" class="ac-btn edit" bindtap="editActivity" data-idx="{{idx}}">编辑</view>
      </view>
    </view>
  </scroll-view>

  <view wx:if="{{showJoinDialog}}" class="overlay" bindtap="hideJoinDialog">
    <view class="join-sheet" catchtap="noop">
      <view class="sheet-title">添加活动人员</view>
      <view class="form-group">
        <text class="form-label">姓名</text>
        <input class="form-input" placeholder="输入你的名字" value="{{joinName}}" bindinput="onJoinNameInput"/>
      </view>
      <view class="form-group">
        <text class="form-label">性别</text>
        <view class="gender-row">
          <view class="gender-option {{joinGender === 'male' ? 'on' : ''}}" data-gender="male" bindtap="selectJoinGender">男</view>
          <view class="gender-option {{joinGender === 'female' ? 'on' : ''}}" data-gender="female" bindtap="selectJoinGender">女</view>
        </view>
      </view>
      <view class="form-group">
        <text class="form-label">级别</text>
        <picker mode="selector" range="{{levels}}" value="{{joinLevelIdx}}" bindchange="selectJoinLevel">
          <view class="form-input picker">{{levels[joinLevelIdx]}}</view>
        </picker>
      </view>
      <view class="sheet-actions">
        <view class="f-btn f-cancel" bindtap="hideJoinDialog">取消</view>
        <view class="f-btn f-submit" bindtap="confirmJoin">确认添加</view>
      </view>
    </view>
  </view>

  <view wx:if="{{cancelTarget > -1}}" class="overlay" bindtap="hideCancelPicker">
    <view class="cancel-sheet" catchtap="noop">
      <view class="sheet-title">选择要取消活动人员的人</view>
      <view wx:for="{{cancelNames}}" wx:key="*this" class="cancel-name-item" catchtap="selectCancelName" data-name="{{item}}">{{item}}</view>
    </view>
  </view>

  <view wx:if="{{showPwd}}" class="overlay" bindtap="hidePwd">
    <view class="pwd-sheet" catchtap="noop">
      <view class="sheet-title">{{pwdMode === 'publish' ? '记录活动' : '删除活动'}} - 验证</view>
      <view class="form-group" style="padding:0 32rpx;">
        <text class="form-label">请输入密码</text>
        <input class="form-input" password type="text" value="{{pwdInput}}" bindinput="onPwdInput" placeholder="请输入密码"/>
      </view>
      <view class="form-actions">
        <view class="f-btn f-cancel" bindtap="hidePwd">取消</view>
        <view class="f-btn f-submit" bindtap="confirmPwd">确认</view>
      </view>
    </view>
  </view>

  <view wx:if="{{showForm}}" class="overlay" bindtap="closeForm">
    <view class="form-sheet" catchtap="noop">
      <view class="form-title">{{formMode === 'add' ? '记录活动' : '编辑活动'}}</view>
      <view class="form-body">
        <view class="form-group">
          <text class="form-label">日期</text>
          <picker mode="date" value="{{formData.date}}" bindchange="formDateChange">
            <view class="form-input picker">{{formData.dateLabel}}</view>
          </picker>
        </view>
        <view class="form-group">
          <text class="form-label">开始时间</text>
          <picker mode="time" value="{{formData.time}}" bindchange="formTimeChange">
            <view class="form-input picker">{{formData.time}}</view>
          </picker>
        </view>
        <view class="form-group">
          <text class="form-label">结束时间</text>
          <picker mode="time" value="{{formData.endTime}}" bindchange="formEndTimeChange">
            <view class="form-input picker">{{formData.endTime}}</view>
          </picker>
        </view>
        <view class="form-group">
          <text class="form-label">类型</text>
          <picker mode="selector" range="{{activityTypes}}" range-key="label" value="{{formTypeIndex}}" bindchange="formTypeChange">
            <view class="form-input picker">{{activityTypes[formTypeIndex].label}}</view>
          </picker>
        </view>
        <view class="form-group">
          <text class="form-label">地点</text>
          <input class="form-input" placeholder="如：酷胜网球中心" value="{{formData.location}}" data-field="location" bindinput="formInput"/>
        </view>
        <view class="form-row">
          <view class="form-group half">
            <text class="form-label">男上限</text>
            <input class="form-input" type="number" value="{{formData.maxMale}}" data-field="maxMale" bindinput="formInput"/>
          </view>
          <view class="form-group half">
            <text class="form-label">女上限</text>
            <input class="form-input" type="number" value="{{formData.maxFemale}}" data-field="maxFemale" bindinput="formInput"/>
          </view>
        </view>
        <view class="form-group">
          <text class="form-label">总人数</text>
          <input class="form-input" type="number" value="{{formData.totalPlayers}}" data-field="totalPlayers" bindinput="formInput"/>
        </view>
        <view class="form-row">
          <view class="form-group half">
            <text class="form-label">男最低级别</text>
            <picker mode="selector" range="{{levels}}" value="{{formData.levelMinMale * 2}}" bindchange="formLevelChange" data-field="levelMinMale">
              <view class="form-input picker">{{formData.levelMinMale}}</view>
            </picker>
          </view>
          <view class="form-group half">
            <text class="form-label">女最低级别</text>
            <picker mode="selector" range="{{levels}}" value="{{formData.levelMinFemale * 2}}" bindchange="formLevelChange" data-field="levelMinFemale">
              <view class="form-input picker">{{formData.levelMinFemale}}</view>
            </picker>
          </view>
        </view>
        <view class="form-group">
          <text class="form-label">费用（元/人）</text>
          <input class="form-input" type="number" value="{{formData.fee}}" data-field="fee" bindinput="formInput"/>
        </view>
      </view>
      <view class="form-actions">
        <view class="f-btn f-cancel" bindtap="closeForm">取消</view>
        <view class="f-btn f-submit" bindtap="submitForm">{{formMode === 'add' ? '记录' : '保存'}}</view>
      </view>
    </view>
  </view>
</view>