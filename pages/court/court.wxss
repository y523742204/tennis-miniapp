.container { min-height: 100vh; background: #f5f5f5; padding-bottom: 160rpx; }
.empty-state { padding: 160rpx 0; }

.mode-tabs {
  display: flex;
  background: #fff;
  padding: 16rpx 20rpx;
  gap: 16rpx;
  position: sticky;
  top: 0;
  z-index: 10;
}
.mode-tab {
  flex: 1;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 32rpx;
  font-size: 28rpx;
  color: #666;
  background: #f5f5f5;
}
.mode-tab.active {
  background: #2ecc71;
  color: #fff;
  font-weight: 600;
}
.mode-tab:active { opacity: 0.8; }

.court-card {
  background: #fff;
  margin: 16rpx 20rpx;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}
.court-card:active { transform: scale(0.98); }
.cc-top { display: flex; align-items: center; margin-bottom: 8rpx; }
.cc-name { font-size: 32rpx; font-weight: 600; color: #222; flex: 1; }
.cc-rating { display: flex; gap: 4rpx; }
.c-star { font-size: 28rpx; color: #ddd; }
.c-star.on { color: #f59e0b; }
.cc-addr { font-size: 26rpx; color: #999; display: block; margin-bottom: 6rpx; }
.cc-phone { font-size: 26rpx; color: #2ecc71; }

.map-wrap { position: relative; height: calc(100vh - 200rpx); }
.map { width: 100%; height: 100%; }
.map-hint {
  position: absolute;
  bottom: 20rpx;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(0,0,0,0.7);
  color: #fff;
  padding: 12rpx 32rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  white-space: nowrap;
}

.fab {
  position: fixed;
  right: 32rpx;
  bottom: 140rpx;
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #2ecc71, #27ae60);
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  font-weight: 300;
  box-shadow: 0 4rpx 20rpx rgba(46,204,113,0.4);
  z-index: 20;
}
.fab:active { transform: scale(0.92); }

.overlay {
  position: fixed; inset: 0; background: rgba(0,0,0,0.45); z-index: 100;
  display: flex; align-items: flex-end; justify-content: center;
}
.form-sheet {
  background: #fff; border-radius: 24rpx 24rpx 0 0; width: 100%;
  max-height: 75vh; overflow-y: auto; animation: slideUp .25s ease;
}
@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}
.form-title { font-size: 34rpx; font-weight: 600; padding: 28rpx 32rpx 16rpx; color: #222; text-align: center; }
.form-body { padding: 0 32rpx; }
.form-group { margin-bottom: 24rpx; }
.form-label { font-size: 26rpx; color: #666; margin-bottom: 8rpx; display: block; }
.form-input {
  width: 100%; height: 72rpx; border: 2rpx solid #e5e7eb; border-radius: 12rpx;
  padding: 0 20rpx; font-size: 28rpx; background: #fafafa;
}
.star-row { display: flex; gap: 12rpx; }
.star { font-size: 48rpx; color: #ddd; }
.star.on { color: #f59e0b; }
.form-actions {
  display: flex; padding: 20rpx 32rpx; gap: 20rpx; border-top: 2rpx solid #eee; margin-top: 8rpx;
}
.f-btn {
  flex: 1; height: 80rpx; display: flex; align-items: center; justify-content: center;
  border-radius: 40rpx; font-size: 30rpx; font-weight: 500;
}
.f-cancel { background: #f5f5f5; color: #666; }
.f-submit { background: linear-gradient(135deg, #2ecc71, #27ae60); color: #fff; }
.f-cancel:active, .f-submit:active { opacity: 0.8; }
