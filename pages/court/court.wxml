<view class="container">
  <view class="mode-tabs">
    <view class="mode-tab {{mode === 'list' ? 'active' : ''}}" data-mode="list" bindtap="switchMode">列表</view>
    <view class="mode-tab {{mode === 'map' ? 'active' : ''}}" data-mode="map" bindtap="switchMode">地图</view>
  </view>

  <view wx:if="{{mode === 'list'}}" class="list-scroll">
    <view wx:if="{{courts.length === 0 && nearbyCourts.length === 0}}" class="empty-state">
      <text>🎾</text>
      <text>还没有添加球场</text>
      <text style="font-size: 26rpx; color: #bbb; margin-top: 12rpx;">切换到地图模式搜索附近网球场</text>
    </view>

    <view wx:if="{{nearbyCourts.length}}" class="section-title">附近网球场（{{nearbyCourts.length}}）</view>
    <view wx:for="{{nearbyCourts}}" wx:for-index="ni" wx:key="id" class="court-card" data-idx="{{ni}}" bindtap="onNearbyTap">
      <view class="cc-top">
        <text class="cc-name">{{item.name}}</text>
        <text class="cc-dist">{{item.distance}}m</text>
      </view>
      <text wx:if="{{item.address}}" class="cc-addr">📍 {{item.address}}</text>
    </view>

    <view wx:if="{{courts.length}}" class="section-title">我的球场</view>
    <view wx:if="{{showMigrate}}" class="migrate-btn" bindtap="onMigrateTap">↑ 迁移本地数据到云端</view>
    <view wx:for="{{courts}}" wx:key="id" class="court-card" data-id="{{item.id}}" bindtap="onCourtTap">
      <view class="cc-top">
        <text class="cc-name">{{item.name}}</text>
        <view class="cc-rating">
          <text wx:for="{{[1,2,3,4,5]}}" wx:for-item="sv" wx:key="*this" class="c-star {{item.rating >= sv ? 'on' : ''}}">★</text>
        </view>
      </view>
      <text wx:if="{{item.address}}" class="cc-addr">📍 {{item.address}}</text>
    </view>
  </view>

  <view wx:if="{{mode === 'map'}}" class="map-wrap">
    <view class="map-search-box">
      <input class="map-search-input" placeholder="搜索球场名称或地址" value="{{searchKeyword}}"
             bindinput="onSearchInput" bindconfirm="onSearchConfirm" confirm-type="search"/>
      <view wx:if="{{searchKeyword && !searching}}" class="map-search-clear" bindtap="onClearSearch">×</view>
      <view wx:if="{{showSuggestions}}" class="map-suggestions">
        <view wx:for="{{searchSuggestions}}" wx:key="id" class="map-suggestion-item" data-tip="{{item}}" bindtap="selectSuggestion">
          <text class="map-sug-name">{{item.name}}</text>
          <text wx:if="{{item.address}}" class="map-sug-addr">{{item.address}}</text>
        </view>
      </view>
    </view>
    <view class="map-toolbar">
      <picker mode="selector" range="{{['1km', '2km', '5km', '10km']}}" value="{{radiusIndex}}" bindchange="radiusChange">
        <view class="map-radius-btn">{{['1km', '2km', '5km', '10km'][radiusIndex]}} ▼</view>
      </picker>
      <view class="map-search-btn {{searching ? 'loading' : ''}}" bindtap="searchNearby">{{searching ? '搜索中...' : '搜附近网球场'}}</view>
    </view>
    <map class="map" longitude="{{mapLongitude}}" latitude="{{mapLatitude}}" scale="14"
         markers="{{markers}}"
         show-location
         bindcallouttap="onCalloutTap">
    </map>
    <view wx:if="{{!hasKey}}" class="map-hint">需在 utils/map.js 配置高德地图 Key</view>
  </view>

  <view wx:if="{{showForm}}" class="overlay" bindtap="closeForm">
    <view class="form-sheet" catchtap="noop">
      <view class="form-title">{{formMode === 'add' ? '添加球场' : '编辑球场'}}</view>
      <view class="form-body">
        <view class="form-group">
          <text class="form-label">球场名称</text>
          <input class="form-input" placeholder="如：中央网球场" value="{{formData.name}}" data-field="name" bindinput="formInput"/>
        </view>
        <view class="form-group">
          <text class="form-label">地址</text>
          <input class="form-input" placeholder="球场地址" value="{{formData.address}}" data-field="address" bindinput="formInput"/>
        </view>
        <view class="form-group">
          <text class="form-label">评分</text>
          <view class="star-row">
            <view class="star {{formData.rating >= 1 ? 'on' : ''}}" bindtap="formRating" data-star="1">★</view>
            <view class="star {{formData.rating >= 2 ? 'on' : ''}}" bindtap="formRating" data-star="2">★</view>
            <view class="star {{formData.rating >= 3 ? 'on' : ''}}" bindtap="formRating" data-star="3">★</view>
            <view class="star {{formData.rating >= 4 ? 'on' : ''}}" bindtap="formRating" data-star="4">★</view>
            <view class="star {{formData.rating >= 5 ? 'on' : ''}}" bindtap="formRating" data-star="5">★</view>
          </view>
        </view>
      </view>
      <view class="form-actions">
        <view class="f-btn f-cancel" bindtap="closeForm">取消</view>
        <view class="f-btn f-submit" bindtap="submitForm">保存</view>
      </view>
    </view>
  </view>

  <view wx:if="{{weather}}" class="weather-bar">
    <text class="w-city">{{weather.city}} </text>
    <text class="w-temp">{{weather.temperature}}°C </text>
    <text class="w-humid">湿度{{weather.humidity}}% </text>
    <text>{{weather.weather}}</text>
  </view>
</view>
