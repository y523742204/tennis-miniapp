.container { padding: 0 0 160rpx; min-height: 100vh; background: #f5f5f5; }

/* ─── 排赛表单 ─── */
.sch-create-form {
  background: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.sch-field {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.sch-label {
  width: 100rpx;
  font-size: 28rpx;
  color: #666;
  flex-shrink: 0;
}

.sch-picker {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  padding: 12rpx 16rpx;
  background: #fafafa;
  border: 2rpx solid #e5e7eb;
  border-radius: 10rpx;
}

.sch-row {
  display: flex;
  gap: 20rpx;
}

.sch-half {
  flex: 1;
}

/* ─── 选手姓名 ─── */
.sch-name-section {
  margin: 16rpx 0;
  padding: 20rpx 0;
  border-top: 2rpx solid #f0f0f0;
}

.sch-name-title {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.sch-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.sch-name-tag {
  width: 36rpx;
  font-size: 24rpx;
  text-align: center;
  flex-shrink: 0;
}

.sch-round-label {
  width: 96rpx;
  font-size: 26rpx;
  color: #666;
  flex-shrink: 0;
}

.sch-two-col-section {
  display: flex;
  gap: 16rpx;
}
.sch-col { flex: 1; min-width: 0; }
.sch-col-divider {
  width: 2rpx;
  background: #eee;
  flex-shrink: 0;
}
.sch-name-two-col {
  display: flex;
  gap: 20rpx;
}

.sch-name-col {
  flex: 1;
  min-width: 0;
}
.sch-name-singles { width: 100%; }

.sch-name-input {
  flex: 1;
  height: 64rpx;
  border: 2rpx solid #e5e7eb;
  border-radius: 10rpx;
  padding: 0 16rpx;
  font-size: 28rpx;
  background: #fafafa;
}

/* ─── 历史名单 ─── */
.sch-roster-actions { display: flex; gap: 16rpx; margin-top: 12rpx; }
.sch-roster-btn {
  flex: 1; height: 60rpx; display: flex; align-items: center; justify-content: center;
  border: 2rpx solid #07c160; border-radius: 30rpx; font-size: 26rpx; color: #07c160; background: #fff;
}
.sch-roster-btn:active { opacity: 0.7; }
.sch-roster-dialog {
  margin-top: 12rpx; padding: 16rpx; background: #f9f9f9; border-radius: 12rpx;
}
.sch-roster-input {
  width: 100%; height: 64rpx; border: 2rpx solid #e5e7eb; border-radius: 10rpx;
  padding: 0 16rpx; font-size: 28rpx; background: #fff; box-sizing: border-box;
}
.sch-roster-dlg-actions { display: flex; gap: 16rpx; margin-top: 12rpx; }
.sch-roster-empty { font-size: 26rpx; color: #ccc; text-align: center; padding: 20rpx 0; }
.sch-roster-item {
  display: flex; align-items: center; padding: 12rpx 0; border-bottom: 1rpx solid #f0f0f0;
}
.sch-roster-info { flex: 1; min-width: 0; }
.sch-roster-name { font-size: 28rpx; color: #333; font-weight: 600; display: block; }
.sch-roster-meta { font-size: 22rpx; color: #999; display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.sch-roster-del { font-size: 32rpx; color: #e53935; padding: 4rpx 12rpx; }

/* ─── 固定搭档 ─── */
.sch-fixed-pair-row {
  display: flex;
  align-items: center;
  padding: 10rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.sch-fixed-pair-text {
  flex: 1;
  font-size: 26rpx;
  color: #333;
}
.sch-fixed-pair-del {
  font-size: 32rpx;
  color: #e53935;
  padding: 4rpx 12rpx;
}
.sch-fixed-pair-add {
  font-size: 26rpx;
  color: #07c160;
  padding: 14rpx 0;
  text-align: center;
}
.sch-fixed-pair-panel {
  margin-top: 12rpx;
  padding: 16rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
}
.sch-fp-hint {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 12rpx;
}
.sch-fp-players {
  display: flex;
  gap: 12rpx;
  margin-bottom: 12rpx;
}
.sch-fp-col {
  flex: 1;
  min-width: 0;
}
.sch-fp-col-divider {
  width: 2rpx;
  background: #eee;
  flex-shrink: 0;
}
.sch-fp-player {
  padding: 12rpx 16rpx;
  margin-bottom: 8rpx;
  border: 2rpx solid #e5e7eb;
  border-radius: 10rpx;
  font-size: 28rpx;
  color: #333;
  background: #fff;
  text-align: center;
}
.sch-fp-player:active {
  opacity: 0.7;
}
.sch-fp-player.sel {
  border-color: #07c160;
  background: #f0fdf4;
  color: #07c160;
  font-weight: 600;
}
.sch-fp-tag {
  font-size: 24rpx;
  margin-right: 8rpx;
}
.sch-fp-row {
  display: flex;
  align-items: center;
  padding: 10rpx 0;
}
.sch-fp-row .sch-label {
  width: 120rpx;
}
.sch-fp-selection {
  font-size: 26rpx;
  color: #333;
  padding: 10rpx 0;
  text-align: center;
}
.sch-fp-selection .dim {
  color: #ccc;
}
.sch-fp-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 12rpx;
}
.sch-fp-btn {
  flex: 1;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 32rpx;
  font-size: 28rpx;
}
.sch-fp-cancel {
  background: #f0f0f0;
  color: #666;
}
.sch-fp-confirm {
  background: #07c160;
  color: #fff;
}

.sch-generate {
  margin-top: 24rpx;
  height: 80rpx;
  background: #07c160;
  color: #fff;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sch-generate:active { opacity: 0.8; }

/* ─── 已保存排赛 ─── */
.sch-list { margin: 20rpx; }
.sch-list-title { font-size: 28rpx; color: #333; font-weight: 600; margin-bottom: 16rpx; }

.sch-item {
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 1rpx 6rpx rgba(0,0,0,0.04);
}

.sch-item-info {
  flex: 1;
  min-width: 0;
}

.sch-item-mode {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  display: block;
}

.sch-item-detail {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
  display: block;
}

.sch-item-players {
  font-size: 22rpx;
  color: #bbb;
  margin-top: 2rpx;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sch-item-del {
  font-size: 26rpx;
  color: #e53935;
  padding: 10rpx 16rpx;
  flex-shrink: 0;
}

/* ─── 排赛对阵表 ─── */
.sch-header {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
  position: sticky;
  top: 0;
  z-index: 10;
}

.sch-back {
  font-size: 32rpx;
  color: #07c160;
  padding: 8rpx 16rpx;
}

.sch-title {
  flex: 1;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.sch-meta {
  display: flex;
  justify-content: center;
  gap: 24rpx;
  padding: 16rpx;
  background: #fafafa;
  font-size: 24rpx;
  color: #999;
  border-bottom: 1rpx solid #eee;
}

.round-card {
  background: #fff;
  margin: 16rpx 20rpx;
  border-radius: 14rpx;
  padding: 20rpx 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.round-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 14rpx;
  padding-bottom: 14rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.round-bye {
  font-size: 24rpx;
  font-weight: 400;
  color: #bbb;
}

.match-row {
  padding: 10rpx 0;
  display: flex;
  align-items: center;
}
.match-row::after {
  content: '';
  width: 120rpx;
  flex-shrink: 0;
}

.match-court {
  font-size: 24rpx;
  color: #07c160;
  width: 120rpx;
  flex-shrink: 0;
}

.match-players {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.vs {
  font-size: 22rpx;
  color: #bbb;
  font-weight: 400;
  margin: 0 8rpx;
}

.sch-save-bar {
  padding: 20rpx 20rpx 0;
}
.sch-save-bar .sch-save-btn {
  display: block;
  padding: 20rpx 0;
  text-align: center;
}

.sch-export-bar {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 20rpx 20rpx;
}

.sch-save-btn {
  display: inline-block;
  padding: 20rpx 60rpx;
  background: #07c160;
  color: #fff;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 40rpx;
  text-align: center;
}

.sch-save-btn:active { opacity: 0.8; }
.sch-export-bar .sch-save-btn { flex: 1; padding: 20rpx 0; }
.sch-export-btn { background: #4a90d9; }
.sch-excel-btn { background: #e8a838; }

.hidden-canvas { position: fixed; left: -9999px; top: 0; }

/* ─── 编辑按钮 ─── */
.sch-edit-btn {
  font-size: 26rpx;
  color: #07c160;
  padding: 8rpx 20rpx;
  border: 2rpx solid #07c160;
  border-radius: 24rpx;
  flex-shrink: 0;
}
.sch-edit-btn.active {
  color: #fff;
  background: #07c160;
}

/* ─── 编辑提示 ─── */
.edit-toolbar {
  margin: 12rpx 20rpx 0;
  padding: 14rpx 20rpx;
  font-size: 24rpx;
  color: #b8860b;
  background: #fff9e6;
  border: 2rpx dashed #f0c040;
  border-radius: 10rpx;
  text-align: center;
}
.edit-tip {
  margin: 6rpx 20rpx 0;
  padding: 8rpx 20rpx;
  font-size: 22rpx;
  color: #b8860b;
  text-align: center;
}

/* ─── 等位区 ─── */
.waiting-area {
  margin: 16rpx 20rpx;
  background: #fff9e6;
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
  border: 2rpx dashed #f0c040;
}
.waiting-header {
  font-size: 26rpx;
  font-weight: 600;
  color: #b8860b;
  margin-bottom: 10rpx;
}
.waiting-body {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  min-height: 80rpx;
  align-content: flex-start;
}
.waiting-empty {
  font-size: 24rpx;
  color: #ccc;
  line-height: 64rpx;
}
.waiting-empty.hint {
  color: #b8860b;
  width: 100%;
  text-align: center;
}

/* ─── 编辑模式卡片 ─── */
.match-teams-edit {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  gap: 8rpx;
}
.match-team {
  display: flex;
  align-items: center;
  gap: 4rpx;
}
.player-wrap {
  display: flex;
  align-items: center;
  gap: 4rpx;
}
.player-card {
  display: inline-block;
  padding: 6rpx 14rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #333;
  background: #f0fdf4;
  border: 2rpx solid #c6e9c6;
  border-radius: 10rpx;
  line-height: 1.4;
  max-width: 140rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  transition: all 0.15s;
}
.player-card.sel {
  background: #07c160;
  color: #fff;
  border-color: #07c160;
  box-shadow: 0 0 0 4rpx rgba(7,193,96,0.3);
}
.player-card:active {
  opacity: 0.7;
}
.player-slot {
  display: inline-block;
  padding: 6rpx 14rpx;
  font-size: 22rpx;
  color: #ccc;
  border: 2rpx dashed #ddd;
  border-radius: 10rpx;
  line-height: 1.4;
  min-width: 48rpx;
  text-align: center;
}
.card-plus {
  font-size: 20rpx;
  color: #bbb;
  font-weight: 400;
}
.vs-text {
  font-size: 20rpx;
  color: #bbb;
  font-weight: 600;
  margin: 0 6rpx;
  flex-shrink: 0;
  padding: 10rpx 0;
}
