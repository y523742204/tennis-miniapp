.container { padding: 0 0 160rpx; min-height: 100vh; background: #f5f5f5; }

/* ─── 排赛表单 ─── */
.sch-create-form {
  background: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.sch-field {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.sch-label {
  width: 100rpx;
  font-size: 28rpx;
  color: #666;
  flex-shrink: 0;
}

.sch-picker {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  padding: 10rpx 0;
}

.sch-row {
  display: flex;
  gap: 20rpx;
}

.sch-half {
  flex: 1;
}

/* ─── 选手姓名 ─── */
.sch-name-section {
  margin: 16rpx 0;
  padding: 20rpx 0;
  border-top: 2rpx solid #f0f0f0;
}

.sch-name-title {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.sch-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.sch-name-tag {
  width: 36rpx;
  font-size: 24rpx;
  text-align: center;
  flex-shrink: 0;
}

.sch-round-label {
  width: 96rpx;
  font-size: 26rpx;
  color: #666;
  flex-shrink: 0;
}

.sch-two-col-section {
  display: flex;
  gap: 16rpx;
}
.sch-col { flex: 1; min-width: 0; }
.sch-col-divider {
  width: 2rpx;
  background: #eee;
  flex-shrink: 0;
}
.sch-name-two-col {
  display: flex;
  gap: 20rpx;
}

.sch-name-col {
  flex: 1;
  min-width: 0;
}

.sch-name-input {
  flex: 1;
  height: 64rpx;
  border: 2rpx solid #e5e7eb;
  border-radius: 10rpx;
  padding: 0 16rpx;
  font-size: 28rpx;
  background: #fafafa;
}

.sch-generate {
  margin-top: 24rpx;
  height: 80rpx;
  background: #07c160;
  color: #fff;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sch-generate:active { opacity: 0.8; }

/* ─── 已保存排赛 ─── */
.sch-list { margin: 20rpx; }
.sch-list-title { font-size: 28rpx; color: #333; font-weight: 600; margin-bottom: 16rpx; }

.sch-item {
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 1rpx 6rpx rgba(0,0,0,0.04);
}

.sch-item-info {
  flex: 1;
  min-width: 0;
}

.sch-item-mode {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  display: block;
}

.sch-item-detail {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
  display: block;
}

.sch-item-players {
  font-size: 22rpx;
  color: #bbb;
  margin-top: 2rpx;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sch-item-del {
  font-size: 26rpx;
  color: #e53935;
  padding: 10rpx 16rpx;
  flex-shrink: 0;
}

/* ─── 排赛对阵表 ─── */
.sch-header {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
  position: sticky;
  top: 0;
  z-index: 10;
}

.sch-back {
  font-size: 32rpx;
  color: #07c160;
  padding: 8rpx 16rpx;
}

.sch-title {
  flex: 1;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.sch-meta {
  display: flex;
  justify-content: center;
  gap: 24rpx;
  padding: 16rpx;
  background: #fafafa;
  font-size: 24rpx;
  color: #999;
  border-bottom: 1rpx solid #eee;
}

.round-card {
  background: #fff;
  margin: 16rpx 20rpx;
  border-radius: 14rpx;
  padding: 20rpx 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.round-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 14rpx;
  padding-bottom: 14rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.round-bye {
  font-size: 24rpx;
  font-weight: 400;
  color: #bbb;
}

.match-row {
  padding: 10rpx 0;
  display: flex;
  align-items: center;
}

.match-court {
  font-size: 24rpx;
  color: #07c160;
  width: 120rpx;
  flex-shrink: 0;
}

.match-players {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.vs {
  font-size: 22rpx;
  color: #bbb;
  font-weight: 400;
  margin: 0 8rpx;
}

.sch-save-bar {
  padding: 20rpx;
  text-align: center;
}

.sch-save-btn {
  display: inline-block;
  padding: 20rpx 60rpx;
  background: #07c160;
  color: #fff;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 40rpx;
}

.sch-save-btn:active { opacity: 0.8; }

/* ─── 编辑按钮 ─── */
.sch-edit-btn {
  font-size: 26rpx;
  color: #07c160;
  padding: 8rpx 20rpx;
  border: 2rpx solid #07c160;
  border-radius: 24rpx;
  flex-shrink: 0;
}
.sch-edit-btn.active {
  color: #fff;
  background: #07c160;
}

/* ─── 等位区 ─── */
.waiting-area {
  margin: 16rpx 20rpx;
  background: #fff9e6;
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
  border: 2rpx dashed #f0c040;
}
.waiting-header {
  font-size: 26rpx;
  font-weight: 600;
  color: #b8860b;
  margin-bottom: 10rpx;
}
.waiting-body {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  min-height: 80rpx;
  align-content: flex-start;
}
.waiting-empty {
  font-size: 24rpx;
  color: #ccc;
  line-height: 64rpx;
}
.waiting-hint {
  width: 100%;
  font-size: 24rpx;
  color: #b8860b;
  padding: 10rpx;
  text-align: center;
  background: #e8d595;
  border-radius: 8rpx;
}
.waiting-empty.hint {
  color: #b8860b;
}

/* ─── 编辑模式卡片 ─── */
.match-teams-edit {
  display: flex;
  align-items: center;
  flex: 1;
  gap: 8rpx;
}
.match-team {
  display: flex;
  align-items: center;
  gap: 4rpx;
}
.player-wrap {
  display: flex;
  align-items: center;
  gap: 4rpx;
}
.player-card {
  display: inline-block;
  padding: 6rpx 14rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #333;
  background: #f0fdf4;
  border: 2rpx solid #c6e9c6;
  border-radius: 10rpx;
  line-height: 1.4;
  transition: all 0.15s;
}
.player-card.sel {
  background: #07c160;
  color: #fff;
  border-color: #07c160;
  box-shadow: 0 0 0 4rpx rgba(7,193,96,0.3);
}
.player-card:active {
  opacity: 0.7;
}
.player-slot {
  display: inline-block;
  padding: 6rpx 14rpx;
  font-size: 22rpx;
  color: #ccc;
  border: 2rpx dashed #ddd;
  border-radius: 10rpx;
  line-height: 1.4;
  min-width: 48rpx;
  text-align: center;
}
.card-plus {
  font-size: 20rpx;
  color: #bbb;
  font-weight: 400;
}
.vs-text {
  font-size: 20rpx;
  color: #bbb;
  font-weight: 600;
  margin: 0 6rpx;
  flex-shrink: 0;
  padding: 10rpx 0;
}
